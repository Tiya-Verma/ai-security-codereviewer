+export async function fetchAvatar(userUrl) {
+  // Labeled positive (CWE-918): a user-controlled URL is fetched server-side
+  // with no allowlist -> SSRF (can reach internal metadata endpoints).
+  const res = await fetch(userUrl);
+  return await res.arrayBuffer();
+}
