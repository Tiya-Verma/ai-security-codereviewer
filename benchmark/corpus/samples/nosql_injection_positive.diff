@@ -0,0 +1,8 @@
+export async function login(req, users) {
+  // Labeled positive (CWE-943): request body objects passed directly into a
+  // Mongo query allow operator injection (e.g. {"$ne": null}).
+  return await users.findOne({
+    username: req.body.username,
+    password: req.body.password,
+  });
+}
