+import subprocess
+
+
+def run_backup(name):
+    # Labeled NEGATIVE (fp-trap): resembles a shell exec, but args are passed
+    # as a list with shell=False, so there is no shell to inject into.
+    subprocess.run(["tar", "czf", f"/backups/{name}.tgz", "/data"],
+                   shell=False, check=True)
